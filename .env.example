# Copy to .env for local development. On Railway, set these as service variables instead.

# Supabase > Connect > Session pooler (use the brawl-dev project locally, brawl in production)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Amazon SES (ap-southeast-1) and the send-only IAM user's access key
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM="Bradly's Birthday Brawl <rsvp@yourdomain.com>"

# Long random string for GET /api/admin/rsvps (openssl rand -hex 32)
ADMIN_TOKEN=

# Where the site lives (used in emails and the calendar file)
PUBLIC_URL=http://localhost:3000

# Dev only: pretend today is this Manila date to test the deadline, e.g. 2026-10-16
# TODAY_OVERRIDE=
